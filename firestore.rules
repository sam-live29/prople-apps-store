rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'prople.org@gmail.com' ||
          request.auth.token.email == 'cloaktailofficial@gmail.com' ||
          request.auth.token.email == 'cloaktailsupport@gmail.com' ||
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@prople\\.co\\.in$')
        ))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && request.auth.token.email != null && resource.data.email == request.auth.token.email) || isAdmin();
      allow write: if isOwner(userId) || isAdmin() || (request.auth != null && request.auth.token.email != null && resource.data.email == request.auth.token.email);

      match /dismissed_notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /apps/{appId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.owner == request.auth.uid ||
        request.resource.data.developerId == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid ||
        (request.auth.token.email != null && (
          request.resource.data.developerEmail == request.auth.token.email ||
          request.resource.data.ownerEmail == request.auth.token.email ||
          request.resource.data.publisherEmail == request.auth.token.email
        )) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (
            resource.data.owner == request.auth.uid ||
            resource.data.developerId == request.auth.uid ||
            resource.data.creatorUid == request.auth.uid ||
            (request.auth.token.email != null && (
              resource.data.developerEmail == request.auth.token.email ||
              resource.data.ownerEmail == request.auth.token.email ||
              resource.data.publisherEmail == request.auth.token.email
            ))
          ) &&
          request.resource.data.owner == resource.data.owner &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isEditorChoice', 'isBanned', 'quarantineStatus', 'strikeCount']))
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.owner == request.auth.uid ||
        resource.data.developerId == request.auth.uid ||
        resource.data.creatorUid == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.developerEmail == request.auth.token.email ||
          resource.data.ownerEmail == request.auth.token.email ||
          resource.data.publisherEmail == request.auth.token.email
        )) ||
        isAdmin()
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
          get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid ||
          isAdmin()
        );
      }
    }

    match /console_configs/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /publisher_registry/{nameId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.targetUid == request.auth.uid ||
          resource.data.publisherUid == request.auth.uid ||
          (request.auth.token.email != null && (
            resource.data.targetEmail == request.auth.token.email ||
            resource.data.publisherEmail == request.auth.token.email
          ))
        )
      );
    }

    match /auth_failed_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /locked_ips/{ipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auth_security_state/{docId} {
      allow read, write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /review_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /app_moderation/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banned_releases/{banId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publisher_restrictions/{pubKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auth_otps/{otpId} {
      allow read, write: if false;
    }

    match /auth_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}

