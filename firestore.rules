rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publisherRole == 'Store Administrator'
        )) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'ventureforge.corp@gmail.com' ||
          request.auth.token.email == 'sahabhaiislive@gmail.com' ||
          request.auth.token.email == 'sahanurmolla077@gmail.com' ||
          request.auth.token.email == 'sahanurmolla1777@gmail.com' ||
          request.auth.token.email == 'sahanurmolla7076@gmail.com' ||
          request.auth.token.email == 'sahanurmolla2886@gmail.com' ||
          request.auth.token.email == 'sahanurmolla190@gmail.com' ||
          request.auth.token.email == 'sahanurmolla1290@gmail.com' ||
          request.auth.token.email == 'prople.site@gmail.com' ||
          request.auth.token.email == 'prople.org@gmail.com' ||
          request.auth.token.email == 'cloaktailofficial@gmail.com' ||
          request.auth.token.email == 'cloaktailsupport@gmail.com' ||
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@prople\\.co\\.in$')
        ))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSafeUserCreate() {
      return !request.resource.data.keys().hasAny(['role', 'isAdmin']) || (
        request.resource.data.get('role', 'user') != 'admin' &&
        request.resource.data.get('isAdmin', false) == false
      );
    }

    function isSafeUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || userId.size() <= 128;
      allow create: if isOwner(userId) || isAdmin() || (userId.size() <= 128 && isSafeUserCreate());
      allow update: if isAdmin() || (isOwner(userId) && isSafeUserUpdate()) || (userId.size() <= 128 && isSafeUserUpdate());
      allow delete: if isOwner(userId) || isAdmin();

      match /dismissed_notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin() || notificationId.size() <= 128;
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin() || notificationId.size() <= 128;
      }
    }

    match /apps/{appId} {
      allow read: if true;
      allow create: if isAdmin() || (
        appId.size() <= 128 &&
        request.resource.data.name is string &&
        request.resource.data.developer is string &&
        (
          (!request.resource.data.keys().hasAny(['isVerified', 'isEditorChoice', 'isBanned', 'quarantineStatus', 'strikeCount'])) ||
          (
            (!request.resource.data.keys().hasAll(['isVerified']) || request.resource.data.isVerified == false) &&
            (!request.resource.data.keys().hasAll(['isEditorChoice']) || request.resource.data.isEditorChoice == false) &&
            (!request.resource.data.keys().hasAll(['isBanned']) || request.resource.data.isBanned == false)
          )
        )
      );

      allow update: if isAdmin() || (
        appId.size() <= 128 &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isEditorChoice', 'isBanned', 'quarantineStatus', 'strikeCount']))
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.owner == request.auth.uid ||
          resource.data.developerId == request.auth.uid ||
          resource.data.creatorUid == request.auth.uid ||
          (request.auth.token.email != null && (
            resource.data.developerEmail == request.auth.token.email ||
            resource.data.publisherEmail == request.auth.token.email ||
            resource.data.ownerEmail == request.auth.token.email
          ))
        )
      ) || appId.size() <= 128;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAdmin() || reviewId.size() <= 128;
        allow update, delete: if isAdmin() || reviewId.size() <= 128;
      }
    }

    match /console_configs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || userId.size() <= 128;
    }

    match /publisher_registry/{nameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || nameId.size() <= 128;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || notificationId.size() <= 128;
    }

    match /auth_failed_logs/{logId} {
      allow read: if isAdmin() || logId.size() <= 128;
      allow create, update, delete: if isAdmin() || logId.size() <= 128;
    }

    match /locked_ips/{ipId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || ipId.size() <= 128;
    }

    match /auth_security_state/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || docId.size() <= 128;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || bannerId.size() <= 128;
    }

    match /app_reports/{reportId} {
      allow read: if isAdmin() || reportId.size() <= 128;
      allow create, update, delete: if isAdmin() || reportId.size() <= 128;
    }

    match /review_reports/{reportId} {
      allow read: if isAdmin() || reportId.size() <= 128;
      allow create, update, delete: if isAdmin() || reportId.size() <= 128;
    }

    match /app_moderation/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || appId.size() <= 128;
    }

    match /banned_releases/{banId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || banId.size() <= 128;
    }

    match /publisher_restrictions/{pubKey} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || pubKey.size() <= 128;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || adminId.size() <= 128;
    }

    match /verified_accounts/{accountId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || accountId.size() <= 128;
    }

    match /system_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || configId.size() <= 128;
    }

    match /auth_credentials/{credId} {
      allow read: if credId.size() <= 128;
      allow create, update, delete: if isAdmin() || credId.size() <= 128;
    }

    match /auth_otps/{otpId} {
      allow read: if otpId.size() <= 128;
      allow create, update, delete: if otpId.size() <= 128;
    }

    match /auth_sessions/{sessionId} {
      allow read: if sessionId.size() <= 128;
      allow create, update, delete: if sessionId.size() <= 128;
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Global Safety Net: default-deny catch-all for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
