rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict administrator check:
    // Requires authenticated user with either an admin document in /admins/{uid},
    // an admin document in /admins/{verified_email}, or hardcoded root administrative email
    // with email_verified == true to strictly prevent email spoofing attacks.
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          request.auth.token.email == 'sahanurmolla3131@gmail.com' ||
          request.auth.token.email == 'ventureforge.corp@gmail.com' ||
          request.auth.token.email == 'sahabhaiislive@gmail.com' ||
          request.auth.token.email == 'sahanurmolla077@gmail.com' ||
          request.auth.token.email == 'sahanurmolla1777@gmail.com' ||
          request.auth.token.email == 'sahanurmolla7076@gmail.com' ||
          request.auth.token.email == 'sahanurmolla2886@gmail.com' ||
          request.auth.token.email == 'sahanurmolla190@gmail.com' ||
          request.auth.token.email == 'sahanurmolla1290@gmail.com' ||
          request.auth.token.email == 'prople.site@gmail.com' ||
          request.auth.token.email == 'prople.org@gmail.com' ||
          request.auth.token.email == 'cloaktailofficial@gmail.com' ||
          request.auth.token.email == 'cloaktailsupport@gmail.com' ||
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@prople\\.co\\.in$')
        ))
      );
    }

    function isPrivilegedRole(roleStr) {
      return roleStr is string && (
        roleStr.matches('(?i).*(admin|moderator|executive|root|manager|staff).*') ||
        roleStr in ['Store Administrator', 'Administrator', 'Admin', 'Moderator', 'Executive', 'Root', 'SuperAdmin', 'admin']
      );
    }

    function isSafeUserCreate() {
      return incoming().get('isAdmin', false) == false &&
        !isPrivilegedRole(incoming().get('role', 'user')) &&
        !isPrivilegedRole(incoming().get('publisherRole', 'Developer'));
    }

    function isSafeUserUpdate() {
      return !incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'email']) &&
        !isPrivilegedRole(incoming().get('role', 'user')) &&
        !isPrivilegedRole(incoming().get('publisherRole', 'Developer'));
    }

    // -------------------------------------------------------------------------
    // User Profiles & Account Data
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isSafeUserCreate();
      allow update: if (isOwner(userId) && isSafeUserUpdate()) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /dismissed_notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /canonical_users/{emailKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /console_configs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // Administrative Access (Privilege Escalation Protected)
    // -------------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /verified_accounts/{accountId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Marketplace Applications Catalogue
    // -------------------------------------------------------------------------

    match /apps/{appId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isAuthenticated() &&
        isValidId(appId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().developer is string && incoming().developer.size() > 0 && incoming().developer.size() <= 150 &&
        (incoming().owner == request.auth.uid || incoming().developerId == request.auth.uid || incoming().creatorUid == request.auth.uid) &&
        (
          !incoming().keys().hasAny(['isVerified', 'isEditorChoice', 'isBanned', 'quarantineStatus', 'strikeCount']) || (
            incoming().get('isVerified', false) == false &&
            incoming().get('isEditorChoice', false) == false &&
            incoming().get('isBanned', false) == false
          )
        )
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        (existing().owner == request.auth.uid || existing().developerId == request.auth.uid || existing().creatorUid == request.auth.uid) &&
        !incoming().diff(existing()).affectedKeys().hasAny(['owner', 'developerId', 'creatorUid', 'isVerified', 'isEditorChoice', 'isBanned', 'quarantineStatus', 'strikeCount'])
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && (
          existing().owner == request.auth.uid ||
          existing().developerId == request.auth.uid ||
          existing().creatorUid == request.auth.uid
        )
      );

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
        allow update: if isAdmin() || (
          isAuthenticated() && (
            (existing().userId == request.auth.uid && !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'appId'])) ||
            (
              exists(/databases/$(database)/documents/apps/$(appId)) &&
              get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['reply', 'updatedAt'])
            )
          )
        );
        allow delete: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      }
    }

    // Direct root collection user reviews index
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        existing().userId == request.auth.uid &&
        !incoming().diff(existing()).affectedKeys().hasAny(['userId', 'appId'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // Publisher Studio Registry & Names
    // -------------------------------------------------------------------------

    match /publisher_registry/{nameId} {
      allow read: if true;
      allow create: if isAuthenticated() && incoming().ownerUid == request.auth.uid;
      allow update: if (isAuthenticated() && existing().ownerUid == request.auth.uid && incoming().ownerUid == existing().ownerUid) || isAdmin();
      allow delete: if (isAuthenticated() && existing().ownerUid == request.auth.uid) || isAdmin();
    }

    match /publisher_restrictions/{pubKey} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Moderation, Banned Releases, and Reports
    // -------------------------------------------------------------------------

    match /app_moderation/{appId} {
      allow read, write: if isAdmin();
    }

    match /banned_releases/{banId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /app_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isValidId(reportId) && incoming().appId is string;
      allow update, delete: if isAdmin();
    }

    match /review_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isValidId(reportId) && incoming().reviewId is string;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Store Notifications (Broadcast Announcements)
    // -------------------------------------------------------------------------

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Sensitive Security Controls & Credentials (ZERO Client Access)
    // -------------------------------------------------------------------------

    match /auth_credentials/{credId} {
      allow read, write: if false;
    }

    match /auth_otps/{otpId} {
      allow read, write: if false;
    }

    match /auth_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /locked_ips/{ipId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auth_failed_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /security_forensics/{forensicId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auth_security_state/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Connection Health Verification
    // -------------------------------------------------------------------------

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Safety Net: default-deny catch-all for any unmapped paths
    // -------------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
