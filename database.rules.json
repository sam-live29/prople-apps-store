{
  "rules": {
    ".read": false,
    ".write": false,
    "_auth_otps": {
      ".read": false,
      ".write": false
    },
    "_auth_sessions": {
      ".read": false,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "liveMetrics": {
      "$appId": {
        ".read": true,
        ".write": "auth != null",
        "downloadsCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "activeUsers": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "downloads": {
      "$appId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "broadcasts": {
      ".read": true,
      ".write": "auth != null && (auth.token.email.matches('.*@prople\\\\.co\\\\.in$') || auth.token.email === 'prople.org@gmail.com' || auth.token.email === 'cloaktailofficial@gmail.com')"
    },
    "test": {
      ".read": false,
      ".write": false
    }
  }
}
